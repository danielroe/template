{
  "name": "package-name",
  "type": "module",
  "version": "0.0.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "description": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielroe/package-name.git"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/index.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "vitest dev",
    "lint": "eslint . --fix",
    "prepare": "simple-git-hooks",
    "prepack": "pnpm lint && pnpm test && pnpm build",
    "test": "pnpm test:unit && pnpm test:types && pnpm test:knip",
    "test:unit": "vitest",
    "test:knip": "knip",
    "test:versions": "installed-check -d --no-workspaces",
    "test:types": "tsc --noEmit"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.3.0",
    "@arethetypeswrong/core": "0.18.5",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "installed-check": "11.0.0",
    "knip": "6.34.0",
    "nano-staged": "1.0.2",
    "pkg-pr-new": "0.0.88",
    "publint": "0.3.24",
    "simple-git-hooks": "2.14.0",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm nano-staged"
  },
  "nano-staged": {
    "*.{js,ts,mjs,cjs,json,.*rc}": [
      "pnpm eslint --fix"
    ]
  }
}
